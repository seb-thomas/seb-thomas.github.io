---
// Click (or Enter/Space) on any image inside a `.zoomable` element to see it
// full size. Click anywhere or press Esc to close.
---

<dialog class="lightbox" aria-label="Enlarged image"></dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;

  function open(img: HTMLImageElement) {
    // Clone the <picture> so the dark-mode <source> still applies, and ask for
    // the largest size that fits the screen.
    const original = img.closest('picture') ?? img;
    const copy = original.cloneNode(true) as HTMLElement;
    // Size it explicitly to the largest box that fits the screen; left to
    // itself the copy keeps the thumbnail's intrinsic size.
    const ratio = img.naturalWidth / img.naturalHeight || Number(img.getAttribute('width')) / Number(img.getAttribute('height'));
    const size = `min(95vw, calc(95vh * ${ratio}))`;
    const big = copy instanceof HTMLImageElement ? copy : copy.querySelector('img')!;
    [big, ...copy.querySelectorAll('source')].forEach((el) => el.setAttribute('sizes', size));
    big.removeAttribute('loading');
    big.style.width = size;
    dialog.replaceChildren(copy);
    dialog.showModal();
  }

  document.querySelectorAll<HTMLImageElement>('.zoomable img').forEach((img) => {
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `View larger: ${img.alt}`);
    img.addEventListener('click', () => open(img));
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open(img);
      }
    });
  });

  dialog.addEventListener('click', () => dialog.close());
</script>

<style is:global>
  .zoomable img {
    cursor: zoom-in;
  }

  .zoomable img:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  dialog.lightbox {
    max-width: 95vw;
    max-height: 95vh;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }

  dialog.lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }

  dialog.lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
  }
</style>
