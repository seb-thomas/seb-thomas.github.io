---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Footer from '../components/Footer.astro';
import ThemedImage from '../components/ThemedImage.astro';
import { site, projects, about, approach } from '../data/site';

const tiles = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#approach', label: 'Approach' },
  { href: '#contact', label: 'Contact' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageOf = (p: (typeof projects)[number]) => `${base}/work/${p.slug}/`;

const features = projects.filter((p) => p.size === 'feature');
const smalls = projects.filter((p) => p.size === 'small');
---

<Base title={`${site.firstName} ${site.lastName} · ${site.title}`}>
  <main>
    <div class="first-screen">
    <section class="hero wrap">
      <div class="lockup">
        <h1 class="first">{site.firstName.toUpperCase()}</h1>
        <span class="side portfolio" aria-hidden="true">PORTFOLIO</span>
        <nav class="tiles" aria-label="Sections">
          {
            tiles.map((t, i) => (
              <a class="tile" href={t.href}>
                <span class="num">0{i + 1}</span>
                <span class="arrow">
                  <Arrow size={36} />
                </span>
                <span class="name">{t.label}</span>
              </a>
            ))
          }
        </nav>
        <span class="side last" aria-hidden="true">{site.lastName.toUpperCase()}</span>
        <p class="title">{site.title.toUpperCase()}</p>
      </div>
    </section>

    <section class="intro wrap">
      <p class="lead">{site.intro}</p>
      <p class="note">{site.introNote}</p>
    </section>
    </div>

    <ul class="roles wrap" aria-label="What I do">
      {site.roles.map((r) => <li>{r}</li>)}
    </ul>

    <section id="work" class="work wrap" aria-labelledby="work-h">
      <p class="label">Work</p>
      <h2 id="work-h" class="display work-h">Recent work</h2>

      {
        features.map((p) => (
          <article class="project feature">
            <a class:list={['panel', p.layout]} href={pageOf(p)} style={`background: ${p.panel}`} aria-label={p.title}>
              {p.layout === 'dialog-and-phones' && (
                <>
                  <ThemedImage class="dialog" src={p.shots[0].src} dark={p.shots[0].dark} alt={p.shots[0].alt} widths={[520, 1040]} sizes="(min-width: 60rem) 32.5rem, 80vw" />
                  {p.shots.slice(1).map((s) => (
                    <ThemedImage class="phone" src={s.src} dark={s.dark} alt={s.alt} widths={[200, 400]} sizes="12.5rem" />
                  ))}
                </>
              )}
              {p.layout === 'main-and-side' && (
                <>
                  <Image class="main" src={p.shots[0].src} alt={p.shots[0].alt} widths={[720, 1440]} sizes="(min-width: 60rem) 45rem, 90vw" />
                  <span class="side-shots">
                    {p.shots.slice(1).map((s) => (
                      <Image src={s.src} alt={s.alt} widths={[400, 800]} sizes="(min-width: 60rem) 22rem, 90vw" />
                    ))}
                  </span>
                </>
              )}
            </a>
            <div class="head">
              <h3><a href={pageOf(p)}>{p.title}</a></h3>
              <span class="arrow-mark">
                <Arrow size={32} />
              </span>
            </div>
            <p class="desc">{p.description}</p>
            <div class="meta label">
              <span>{p.stack.join(' / ')}</span>
              <span class="role">
                {p.role} · {p.year}
              </span>
            </div>
          </article>
        ))
      }

      <div class="smalls">
        {
          smalls.map((p) => (
              <article class="project small">
                <a class="panel" href={pageOf(p)} style={`background: ${p.panel}`} aria-label={p.title}>
                  <Image src={p.shots[0].src} alt={p.shots[0].alt} widths={[560, 1120]} sizes="(min-width: 60rem) 32rem, 90vw" />
                </a>
                <div class="head">
                  <h3><a href={pageOf(p)}>{p.title}</a></h3>
                  <span class="arrow-mark">
                    <Arrow size={28} />
                  </span>
                </div>
                <p class="desc">{p.description}</p>
                <div class="meta label">
                  <span>{p.stack.join(' / ')}</span>
                  <span class="role">
                    {p.role} · {p.year}
                  </span>
                </div>
              </article>
          ))
        }
      </div>
    </section>

    <section id="about" class="about" aria-labelledby="about-h">
      <div class="wrap about-inner">
        <div class="about-text">
          <p class="label">About</p>
          <h2 id="about-h" class="display">{about.heading}</h2>
          {about.paragraphs.map((t) => <p>{t}</p>)}
          <div class="squares" aria-hidden="true"><span></span><span></span></div>
        </div>
        <div class="focus">
          <p class="label">What I spend time on</p>
          {
            about.focus.map((f) => (
              <div class="focus-item">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="approach" class="approach" aria-labelledby="approach-h">
      <div class="wrap">
        <div class="approach-head">
          <p class="label">Approach</p>
          <h2 id="approach-h" class="display">How I like to work</h2>
        </div>
        <div class="approach-grid">
          {
            approach.map((a) => (
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-h">
      <div class="wrap contact-inner">
        <div>
          <p class="label">Contact</p>
          <h2 id="contact-h" class="display">Good things start with hello.</h2>
          <a class="email" href={`mailto:${site.email}`}>{site.email} ↗</a>
        </div>
        <a class="contact-box" href={`mailto:${site.email}`} aria-label={`Email ${site.firstName}`}>
          <Arrow size={72} strokeWidth={1.2} />
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <p class="toast" role="status" aria-live="polite"></p>
</Base>

<script>
  // mailto: does nothing in browsers without a mail app set up, so clicking an
  // email link also copies the address and says so.
  const toast = document.querySelector<HTMLElement>('.toast')!;
  let timer: number | undefined;

  document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((link) => {
    link.addEventListener('click', () => {
      const email = link.href.replace('mailto:', '');
      navigator.clipboard?.writeText(email).then(() => {
        toast.textContent = `Copied ${email}`;
        toast.classList.add('show');
        clearTimeout(timer);
        timer = window.setTimeout(() => toast.classList.remove('show'), 2500);
      });
    });
  });
</script>

<style>
  /* The lockup and the two intro paragraphs fill the first screen exactly;
     the roles strip starts below the fold. */
  .first-screen {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(1.5rem, 5svh, 3.5rem);
  }

  .first-screen > .intro {
    width: 100%;
  }

  /* Hero: name lockup around the four section tiles. --t is one tile's side;
     it shrinks with the viewport height too, so everything above fits. */
  .hero {
    --t: clamp(120px, min(20vw, (100svh - 22rem) / 2.6), 230px);
    display: flex;
    justify-content: center;
    padding-bottom: clamp(2.5rem, 8svh, 5rem);
  }

  .lockup {
    display: grid;
    grid-template-columns: auto calc(var(--t) * 2) auto;
    grid-template-areas:
      '. first .'
      'portfolio tiles last'
      '. title .';
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-items: center;
    font-family: var(--display);
    line-height: 0.9;
  }

  .first {
    grid-area: first;
    margin: 0;
    font-size: calc(var(--t) * 0.348);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .side {
    writing-mode: vertical-rl;
    text-align: center;
    letter-spacing: -0.01em;
  }

  .portfolio {
    grid-area: portfolio;
    transform: rotate(180deg);
    font-size: calc(var(--t) * 0.296);
    font-weight: 500;
  }

  .last {
    grid-area: last;
    font-size: calc(var(--t) * 0.417);
    font-weight: 700;
  }

  .title {
    grid-area: title;
    margin: 0;
    font-size: calc(var(--t) * 0.243);
    line-height: 1;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .tiles {
    grid-area: tiles;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tile {
    height: var(--t);
    padding: 1rem;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'num arrow'
      'name name';
    align-content: space-between;
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    font-family: var(--sans);
    line-height: 1.3;
  }

  .tile:nth-child(1),
  .tile:nth-child(3) {
    border-right: 1px solid #ffffff33;
  }

  .tile:nth-child(1),
  .tile:nth-child(2) {
    border-bottom: 1px solid #ffffff33;
  }

  .tile:nth-child(4) {
    background: var(--lime);
    color: var(--ink);
  }

  .tile:hover {
    color: var(--ink);
    filter: brightness(1.08);
  }

  .tile:nth-child(-n + 3):hover {
    color: #fff;
  }

  .num {
    grid-area: num;
    font-family: var(--mono);
    font-size: 0.6875rem;
  }

  .tile .arrow {
    grid-area: arrow;
  }

  .name {
    grid-area: name;
    font-size: 1.5rem;
    font-weight: 500;
  }

  /* On a phone the tiles stack into bars, with the surname down the right */
  @media (max-width: 40rem) {
    .hero {
      display: block;
      padding-bottom: clamp(2rem, 5svh, 3rem);
    }

    .lockup {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'first first'
        'tiles last'
        'title title';
      column-gap: 0.5rem;
      align-items: stretch;
    }

    .first {
      font-size: calc((100vw - 2rem) * 0.15);
      text-align: left;
    }

    .portfolio {
      display: none;
    }

    .last {
      font-size: 3.375rem;
      line-height: 0.88;
    }

    .title {
      font-size: calc((100vw - 2rem) * 0.118);
      text-align: left;
    }

    .tiles {
      grid-template-columns: 1fr;
    }

    .tile {
      height: 60px;
      padding: 0 0.875rem;
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'num name arrow';
      align-content: center;
      align-items: center;
      column-gap: 0.75rem;
      border-right: 0 !important;
      border-bottom: 1px solid #ffffff33;
    }

    .tile .arrow :global(svg) {
      width: 24px;
      height: 24px;
    }

    .name {
      font-size: 1.1875rem;
    }
  }

  /* Intro */
  .lead {
    margin: 0;
    max-width: 52rem;
    font-size: clamp(1.1875rem, 2vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .note {
    margin: 1rem 0 0;
    max-width: 52rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  /* .wrap supplies the side margins and gutters */
  .roles {
    list-style: none;
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    font-size: 0.875rem;
  }

  .roles li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .roles li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--blue);
  }

  /* Work */
  /* Margin rather than padding, so the #work link lands on the heading */
  .work {
    margin-top: clamp(4.5rem, 9vw, 7rem);
    scroll-margin-top: 2rem;
  }

  .work-h {
    margin: 1rem 0 2rem;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
  }

  .project.feature {
    padding-bottom: 5rem;
  }

  .panel {
    display: block;
  }

  .panel.dialog-and-phones {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4.5rem);
  }

  /* The dialog and phones are ThemedImage <picture>s, outside this scope */
  .dialog-and-phones :global(img) {
    width: 100%;
    border-radius: inherit;
  }

  .dialog-and-phones :global(.dialog) {
    flex: 2 1 22.5rem;
    min-width: 0;
    max-width: 32.5rem;
    border-radius: 8px;
  }

  .dialog-and-phones :global(.phone) {
    flex: 1 1 8.75rem;
    min-width: 0;
    max-width: 12.5rem;
    border-radius: 12px;
  }

  .panel.main-and-side {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4.5vw, 3.5rem) clamp(1.25rem, 5vw, 4rem);
  }

  .main-and-side .main {
    flex: 2 1 30rem;
    min-width: 0;
  }

  .side-shots {
    flex: 1 1 15rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .main-and-side img {
    border-radius: 6px;
    border: 1px solid var(--shot-line);
  }

  .smalls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21.25rem), 1fr));
    gap: 1.75rem;
    padding-bottom: 2.5rem;
  }

  .small .panel {
    padding: clamp(1.25rem, 3.5vw, 2.75rem);
  }

  .small .panel img {
    border-radius: 6px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .head h3 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.625rem, 2.5vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .small .head h3 {
    font-size: 1.625rem;
  }

  .head h3 a {
    text-decoration: none;
  }

  .arrow-mark {
    color: var(--accent);
    display: flex;
  }

  .desc {
    margin: 0.375rem 0 0.875rem;
    max-width: 47.5rem;
    color: var(--body);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .meta .role {
    color: var(--accent);
  }

  /* About */
  .about {
    margin-top: 5rem;
    background: var(--sage);
  }

  .about-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .about-text {
    flex: 1 1 25rem;
    min-width: 0;
  }

  .about-text h2 {
    margin: 1.5rem 0;
    font-size: clamp(2.125rem, 4vw, 3rem);
  }

  .about-text p:not(.label) {
    margin: 0 0 0.875rem;
    max-width: 29rem;
    color: var(--body);
  }

  .squares {
    display: flex;
    margin-top: 1.75rem;
  }

  .squares span {
    width: 44px;
    height: 44px;
    background: var(--blue);
  }

  .squares span + span {
    background: var(--lime);
  }

  .focus {
    flex: 1 1 28.75rem;
    min-width: 0;
  }

  .focus .label {
    padding-bottom: 0.75rem;
  }

  .focus-item {
    padding-block: 1rem;
    border-top: 1px solid var(--sage-line);
  }

  .focus-item:last-child {
    border-bottom: 1px solid var(--sage-line);
  }

  .focus-item h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .focus-item p {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--body);
  }

  /* Approach */
  .approach {
    background: var(--blue);
    color: #fff;
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .approach-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #ffffff55;
  }

  .approach-head h2 {
    font-size: clamp(2.125rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.25rem, 1fr));
    gap: 2.5rem;
    padding-top: 1.75rem;
  }

  .approach-grid h3 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    font-weight: 500;
  }

  .approach-grid p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--blue-soft);
  }

  /* Contact */
  .contact {
    background: var(--lime);
    color: var(--ink);
  }

  .contact-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 7vw, 5rem) clamp(3rem, 7vw, 5.5rem);
  }

  .contact h2 {
    margin-top: 2rem;
    max-width: 14ch;
    font-size: clamp(3.25rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .email:hover {
    color: var(--blue);
  }

  .contact-box {
    width: clamp(4rem, 9vw, 7.5rem);
    height: clamp(4rem, 9vw, 7.5rem);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: #fff;
  }

  .contact-box:hover {
    color: #fff;
    opacity: 0.92;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    margin: 0;
    padding: 0.625rem 1rem;
    background: var(--ink);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    transform: translate(-50%, 1rem);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease-out,
      transform 160ms ease-out;
  }

  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .contact-box :global(svg) {
    width: 60%;
    height: 60%;
  }
</style>
