---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Footer from '../../components/Footer.astro';
import { projects, linkSdk } from '../../data/site';
import '../../styles/case.css';

const sdk = projects.find((p) => p.title === 'Link SDK 2.0')!;
const next = projects.find((p) => p.title === 'Lean Dashboard')!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const facts = [
  { term: 'Role', value: 'Lead engineer' },
  { term: 'Team', value: 'Two to three engineers' },
  { term: 'Markets', value: 'UAE and KSA' },
  { term: 'Stack', value: 'TypeScript, React, React Query, Radix UI, Storybook, Sentry' },
];

const steps = [
  {
    title: 'Components first',
    text: 'Every screen is built from a TypeScript component library on Radix UI, worked out in Storybook before it went into a flow.',
  },
  {
    title: 'Bank steps as a state machine',
    text: 'One-time codes, security questions, captchas and app approvals are states rather than special cases, so the guidance on screen matches what each bank actually asks for.',
  },
  {
    title: 'A slow rollout',
    text: 'Shipped over the air to a growing share of users behind feature flags, watched in Sentry, so we could switch it off if something went wrong. Clients didn’t need to change anything.',
  },
];
---

<Base title="Link SDK 2.0 — Sebastian Thomas" description="Rebuilding Lean’s Link SDK, the flow people use to connect their bank and pay inside other apps.">
  <header class="wrap top">
    <a class="label" href={`${base}/`}>← Sebastian Thomas</a>
    <span class="label muted">Lean Technologies · {sdk.year}</span>
  </header>

  <main>
    <section class="wrap title">
      <h1 class="display">Link SDK 2.0</h1>
      <p>A rebuild of the flow people use to connect their bank and pay inside other apps.</p>
    </section>

    <dl class="wrap facts">
      {
        facts.map((f) => (
          <div>
            <dt class="label">{f.term}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="wrap">
      <div class="hero-panel">
        <Image src={sdk.shots[0].src} alt={sdk.shots[0].alt} widths={[640, 1280]} sizes="(min-width: 45rem) 40rem, 90vw" />
      </div>
    </div>

    <section class="wrap row">
      <h2 class="label">What it is</h2>
      <div class="prose">
        <p>
          When someone links their bank account or pays inside an app that uses Lean, this is the window that opens. It talks to many
          different banks, each with its own way of checking it’s really you.
        </p>
        <p class="soft">
          I built the first version in 2020. In 2025 we redesigned the screens, added dark mode and better layouts for small screens, and
          rebuilt what was underneath.
        </p>
      </div>
    </section>

    <section class="wrap row">
      <h2 class="label">How we built it</h2>
      <div class="steps">
        {
          steps.map((s) => (
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap figures">
      <figure>
        <div class="fig-panel sage">
          <Image src={linkSdk.storybook.src} alt={linkSdk.storybook.alt} widths={[560, 1120]} sizes="(min-width: 60rem) 32rem, 90vw" />
        </div>
        <figcaption class="label">The ADCB bank screen in Storybook</figcaption>
      </figure>
      <figure>
        <div class="fig-panel mauve phones">
          {linkSdk.phones.map((s) => <Image src={s.src} alt={s.alt} widths={[200, 400]} sizes="10rem" />)}
        </div>
        <figcaption class="label">Pick a bank, enter a code, confirm</figcaption>
      </figure>
    </section>

    <section class="wrap row last-row">
      <h2 class="label">What changed</h2>
      <div class="numbers">
        <div>
          <div class="num">+15%</div>
          <p>More people finished connecting their bank</p>
        </div>
        <div>
          <div class="num">75→89%</div>
          <p>Payments that went through</p>
        </div>
      </div>
    </section>

    <a class="next" href={next.href}>
      <div class="wrap next-inner">
        <div>
          <p class="label">Next</p>
          <span class="display">{next.title}</span>
        </div>
        <span class="next-box"><Arrow size={52} strokeWidth={1.2} /></span>
      </div>
    </a>
  </main>
  <Footer />
</Base>
